{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ardia",
  "version": "0.1.0",
  "identifier": "dev.ardia.browser",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ardia",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "hiddenTitle": false,
        "titleBarStyle": "visible",
        "disableDragDropHandler": false,
        "skipTaskbar": false,
        "theme": "default",
        "webviewVersion": "130.0.0.0"
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob: tauri:; script-src 'self' 'unsafe-inline' 'unsafe-eval' tauri:; style-src 'self' 'unsafe-inline' tauri:; img-src 'self' data: blob: tauri: https:; font-src 'self' data: tauri:; connect-src 'self' tauri: https: wss:; frame-src 'self' data: blob: tauri:; worker-src 'self' blob: tauri:;",
      "freezePrototype": true,
      "devtoolAccess": true
    },
    "trayIcon": {
      "iconPath": "icons/icon.svg",
      "menu": [
        { "id": "show", "text": "Show Ardia", "accelerator": "Ctrl+Shift+A" },
        { "id": "new-window", "text": "New Window", "accelerator": "Ctrl+N" },
        { "id": "new-private", "text": "New Private Window", "accelerator": "Ctrl+Shift+N" },
        { "type": "separator" },
        { "id": "quit", "text": "Quit", "accelerator": "Ctrl+Q" }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.svg"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "perUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "licenseFile": "",
        "headerImage": "",
        "sidebarImage": "",
        "welcomeImage": ""
      }
    }
  },
  "plugins": {
    "store": {
      "saveOnExit": true
    },
    "sql": {
      "preload": []
    },
    "updater": {
      "active": false,
      "endpoints": [],
      "dialog": true,
      "pubkey": ""
    }
  }
}